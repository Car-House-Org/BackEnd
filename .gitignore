## Ignore Visual Studio / .NET temporary files, build results, and user-specific files

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/XamarinStudio)
*.userprefs

# Mono auto generated files
mono_crash.*

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio cache/options directory
.vs/

# JetBrains Rider
.idea/
*.sln.iml

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# .NET Core / ASP.NET Scaffolding
project.lock.json
project.fragment.lock.json
artifacts/
ScaffoldingReadMe.txt
launchSettings.json.user

# Test results & coverage
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.VisualState.xml
TestResult.xml
nunit-*.xml
coverage*.json
coverage*.xml
coverage*.info
*.coverage
*.coveragexml

# NuGet Packages
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets

# Publish & packaging outputs
*.publish.xml
*.pubxml
*.pubxml.user
PublishScripts/

# Environment, secrets, and local databases
.env
.env.*
!.env.example
appsettings.Local.json
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# OS generated files
.DS_Store
Thumbs.db
*~
